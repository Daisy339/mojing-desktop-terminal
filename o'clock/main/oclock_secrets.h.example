#ifndef OCLOCK_SECRETS_H
#define OCLOCK_SECRETS_H

/* ---------------------------------------------------------------------------
 * Copy this file to `oclock_secrets.h` (same folder) and fill in your own
 * values:
 *
 *     cp main/oclock_secrets.h.example main/oclock_secrets.h
 *
 * `oclock_secrets.h` is listed in .gitignore — keep it that way.
 * ------------------------------------------------------------------------- */

/* Wi-Fi network the terminal should join on boot.
 * Leave the SSID empty to make the device start in AP setup mode. */
#define OCLOCK_WIFI_SSID "your-wifi-ssid"
#define OCLOCK_WIFI_PASSWORD "your-wifi-password"

/* PC-side voice gateway, as reachable from the device.
 * Replace the host with the LAN IP of the computer running gateway/server.py. */
#define OCLOCK_VOICE_GATEWAY_URL "http://192.168.1.100:8765/audio/ask"

/* Shared secret between the device and the gateway.
 * Must match OCLOCK_GATEWAY_TOKEN on the gateway side. */
#define OCLOCK_VOICE_GATEWAY_TOKEN "change-me"

#endif
